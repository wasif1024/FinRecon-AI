# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# LangSmith tracing
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=finrecon-ai
# true: traces keep structure, timings and tokens but no inputs/outputs (use before real customer data)
LANGSMITH_HIDE_CONTENT=false

# PostgreSQL (financial records + LangGraph checkpoints)
DATABASE_URL=postgresql+psycopg://finrecon:finrecon@localhost:5432/finrecon
# Same database as seen from inside a Docker container (docker compose run app ...)
DOCKER_DATABASE_URL=postgresql+psycopg://finrecon:finrecon@host.docker.internal:5432/finrecon

# Qdrant (policy document vector search)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Application logs (stderr + rotating JSON-lines file). Docker mounts ./logs to /app/logs.
LOG_LEVEL=INFO
LOG_FORMAT=console
LOG_FILE=logs/finrecon.log

# Policy documents: original files are kept here; chunks and embeddings live in Qdrant
DOCUMENT_STORAGE_DIR=storage/documents
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# API authentication: generate with `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=
JWT_TTL_MINUTES=60
CORS_ORIGINS=http://localhost:3000

# LangGraph Agent Server / LangSmith Studio (development only; see README)
ENVIRONMENT=development
AGENT_SERVER_URL=http://127.0.0.1:2024
STUDIO_TENANT_SLUG=demo
STUDIO_ACTOR_EMAIL=manager@demo.finrecon.dev
# Finish runs a previous API process left mid-way, at API startup
RECOVER_ON_STARTUP=true
