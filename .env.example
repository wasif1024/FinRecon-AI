# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# LangSmith tracing
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=finrecon-ai
# true: traces keep structure, timings and tokens but no inputs/outputs (use before real customer data)
LANGSMITH_HIDE_CONTENT=false

# OpenTelemetry (traces and metrics over OTLP): off unless set. `scripts/start.sh --otel` runs a local Grafana and
# sets this to http://127.0.0.1:4318. The standard OTEL_* variables (headers, sampler, resource attributes) apply.
OTEL_EXPORTER_OTLP_ENDPOINT=

# PostgreSQL (financial records + LangGraph checkpoints). Two logins (README, Database logins):
# the application's role, which owns nothing and reads and writes rows only ...
DATABASE_URL=postgresql+psycopg://finrecon_app:CHANGE_ME@localhost:5432/finrecon
# ... and the owner of the tables, for `finrecon db migrate` (migrations, checkpoint tables, the app role's rights).
# Leave unset to use DATABASE_URL for both (one login; the API then logs a warning at startup).
MIGRATION_DATABASE_URL=postgresql+psycopg://finrecon:finrecon@localhost:5432/finrecon
# Docker Compose runs its own PostgreSQL with these logins (created on its first start; README, Docker).
# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
FINRECON_DB_PASSWORD=
FINRECON_APP_DB_PASSWORD=
# Point the containers at another database instead (e.g. the host's, via host.docker.internal):
# DOCKER_DATABASE_URL=postgresql+psycopg://finrecon_app:...@host.docker.internal:5432/finrecon
# DOCKER_MIGRATION_DATABASE_URL=postgresql+psycopg://finrecon:...@host.docker.internal:5432/finrecon
# Containers export OpenTelemetry here when set (with --profile otel: http://otel-lgtm:4318)
DOCKER_OTEL_ENDPOINT=

# Qdrant (policy document vector search)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Application logs (stderr + rotating JSON-lines file). Docker mounts ./logs to /app/logs.
LOG_LEVEL=INFO
LOG_FORMAT=console
LOG_FILE=logs/finrecon.log

# Policy documents: original files are kept here; chunks and embeddings live in Qdrant
DOCUMENT_STORAGE_DIR=storage/documents
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# API authentication: generate with `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=
JWT_TTL_MINUTES=60
CORS_ORIGINS=http://localhost:3000

# LangGraph Agent Server / LangSmith Studio: development only. Production (ENVIRONMENT=production) runs every
# workflow in the API process and never calls an Agent Server (README, LangSmith Studio). Empty URL: none.
ENVIRONMENT=development
AGENT_SERVER_URL=http://127.0.0.1:2024
STUDIO_TENANT_SLUG=demo
STUDIO_ACTOR_EMAIL=manager@demo.finrecon.dev
# Finish runs a previous API process left mid-way, at API startup
RECOVER_ON_STARTUP=true
# Case investigations one batch-investigator run may start (each calls Claude)
BATCH_MAX_CASES=5

# Agent workspace: one LangSmith sandbox per case (files only), or `state` (nothing kept after a run).
# Sandboxes need the Sandboxes feature on your LangSmith organization.
AGENT_WORKSPACE=langsmith_sandbox
SANDBOX_IDLE_TTL_SECONDS=600
SANDBOX_DELETE_AFTER_STOP_SECONDS=604800
